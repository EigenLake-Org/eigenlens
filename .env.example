# Core worker bearer token.
VECTOR_CHAT_WORKER_TOKEN=replace-with-a-private-token
VECTOR_CHAT_WORKERS=1
# Generate once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep the same key across restarts; it is separate from the data volume.
VECTOR_ML_CONNECTION_KEY=replace-with-a-generated-fernet-key
# Optional operator-owned default; connect_database with no arguments uses this for caller local.
VECTOR_ML_DATABASE_TYPE=qdrant
VECTOR_ML_DATABASE_URL=http://qdrant:6333
VECTOR_ML_DATABASE_API_KEY=
VECTOR_ML_DATABASE_OPTIONS={}
